# Copie para .env e ajuste (cp .env.example .env). Nada aqui é segredo.

# Endereço do site.
# * Com um domínio (ex.: sorteia.com.br), o Caddy emite e renova o certificado HTTPS sozinho;
#   o DNS precisa apontar para este servidor e as portas 80 e 443 precisam estar abertas.
# * Para testar na própria máquina, sem HTTPS: http://localhost
SITE_ADDRESS=http://localhost

# E-mail de contato exibido na página de privacidade (opcional; entra no build do site).
VITE_CONTACT_EMAIL=

# Portas publicadas no computador/servidor (padrão: 80 e 443).
# HTTP_PORT=80
# HTTPS_PORT=443

# Nível de log da API: DEBUG, INFO, WARNING ou ERROR.
# APP_LOG_LEVEL=INFO

# Rate limit por IP. Desligue SOMENTE para rodar os testes E2E contra esta pilha.
# APP_RATE_LIMIT_ENABLED=true
